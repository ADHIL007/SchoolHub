<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - School Management System</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav>
            <span class="brand">School Management System</span>
            <span class="nav-links">
                @if (Context.Session.GetString("Username") != null)
                {
                    <a asp-controller="Student" asp-action="List">Student List</a>
                    <a asp-controller="Student" asp-action="Register">Register Student</a>
                    <span>Hi, @Context.Session.GetString("FirstName")</span>
                    <a asp-controller="Account" asp-action="Logout">Logout</a>
                }
                else
                {
                    <a asp-controller="Student" asp-action="Register">Register</a>
                    <a asp-controller="Account" asp-action="Login">Login</a>
                }
            </span>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        &copy; 2026 - School Management System
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
