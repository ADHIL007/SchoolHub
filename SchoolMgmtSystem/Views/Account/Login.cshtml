@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<h2>Login</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="message-success">@TempData["SuccessMessage"]</div>
}

<form asp-controller="Account" asp-action="Login" method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <div class="form-group">
        <label asp-for="Username"></label>
        <input asp-for="Username" type="text" />
        <span asp-validation-for="Username" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Password"></label>
        <input asp-for="Password" type="password" />
        <span asp-validation-for="Password" class="field-validation-error"></span>
    </div>

    <button type="submit" class="btn">Login</button>
</form>

<p>Don't have an account? <a asp-controller="Student" asp-action="Register">Register here</a></p>
