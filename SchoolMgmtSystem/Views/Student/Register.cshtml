@model RegisterViewModel
@{
    ViewData["Title"] = "Student Registration";
}

<h2>Student Registration</h2>

<form asp-controller="Student" asp-action="Register" method="post" id="registerForm">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <div class="form-group">
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" type="text" />
        <span asp-validation-for="FirstName" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="LastName"></label>
        <input asp-for="LastName" type="text" />
        <span asp-validation-for="LastName" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Age"></label>
        <input asp-for="Age" type="number" />
        <span asp-validation-for="Age" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="DOB"></label>
        <input asp-for="DOB" type="date" />
        <span asp-validation-for="DOB" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Gender"></label>
        <label><input type="radio" asp-for="Gender" value="Male" /> Male</label>
        <label><input type="radio" asp-for="Gender" value="Female" /> Female</label>
        <label><input type="radio" asp-for="Gender" value="Other" /> Other</label>
        <span asp-validation-for="Gender" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" type="email" />
        <span asp-validation-for="Email" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Phone"></label>
        <input asp-for="Phone" type="tel" />
        <span asp-validation-for="Phone" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Username"></label>
        <input asp-for="Username" type="text" autocomplete="off" />
        <span asp-validation-for="Username" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Password"></label>
        <input asp-for="Password" type="password" autocomplete="new-password" />
        <span asp-validation-for="Password" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
    </div>

    <h3>Qualification Details</h3>

    <table id="qualificationsTable">
        <thead>
            <tr>
                <th>Course</th>
                <th>University</th>
                <th>Year</th>
                <th>Percentage</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="qualificationsBody">
            @for (int i = 0; i < Model.Qualifications.Count; i++)
            {
                <tr>
                    <td><input type="text" name="Qualifications[@i].CourseName" /></td>
                    <td><input type="text" name="Qualifications[@i].University" /></td>
                    <td><input type="number" name="Qualifications[@i].PassingYear" /></td>
                    <td><input type="number" step="0.01" name="Qualifications[@i].Percentage" /></td>
                    <td><button type="button" class="btn btn-small btn-remove removeRowBtn">Remove</button></td>
                </tr>
            }
        </tbody>
    </table>

    <button type="button" id="addRowBtn" class="btn btn-small">Add</button>

    <div>
        <button type="submit" class="btn">Register</button>
    </div>
</form>

@section Scripts {
    <script src="~/js/register.js" asp-append-version="true"></script>
}
