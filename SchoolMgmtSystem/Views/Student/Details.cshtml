@model Student
@{
    ViewData["Title"] = "Student Details";
}

<h2>Student Details</h2>

<table>
    <tr><th>Student Id</th><td>@Model.StudentCode</td></tr>
    <tr><th>Name</th><td>@Model.FirstName @Model.LastName</td></tr>
    <tr><th>Age</th><td>@Model.Age</td></tr>
    <tr><th>DOB</th><td>@Model.DOB.ToString("dd-MMM-yyyy")</td></tr>
    <tr><th>Gender</th><td>@Model.Gender</td></tr>
    <tr><th>Email</th><td>@Model.Email</td></tr>
    <tr><th>Phone</th><td>@Model.Phone</td></tr>
    <tr><th>Username</th><td>@Model.Username</td></tr>
</table>

<h3>Qualifications</h3>

@if (Model.Qualifications.Count == 0)
{
    <p>No qualifications added.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Course</th>
                <th>University</th>
                <th>Year</th>
                <th>Percentage</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Qualification q in Model.Qualifications)
            {
                <tr>
                    <td>@q.CourseName</td>
                    <td>@q.University</td>
                    <td>@q.PassingYear</td>
                    <td>@q.Percentage</td>
                </tr>
            }
        </tbody>
    </table>
}

<p><a asp-controller="Student" asp-action="List">Back to list</a></p>
